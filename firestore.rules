rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin(){
      return request.auth != null
             && request.auth.token.email == 'hasuj007@gmail.com';
    }

    /* El formato se exige ANTES de armar la ruta: sin esto, un código con
       barras podría apuntar a otro documento. */
    function formatoOk(c){
      return c is string && c.matches('^[A-Z0-9-]{3,24}$');
    }

    /* Un código sirve para crear cuenta solo si quien lo presenta ya lo
       reclamó. El reclamo se hace antes, en /invitaciones, y solo puede
       hacerlo una persona: la regla de abajo exige que estuviera libre. */
    function codigoReclamado(c){
      return formatoOk(c)
             && exists(/databases/$(database)/documents/invitaciones/$(c))
             && get(/databases/$(database)/documents/invitaciones/$(c)).data.usadoPor == request.auth.uid;
    }

    match /usuarios/{uid} {
      allow read, update, delete: if request.auth != null
                                  && request.auth.uid == uid;

      // El admin puede recrear su cuenta sin código (red de seguridad para no
      // quedarse fuera de su propia app).
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && (esAdmin() || codigoReclamado(request.resource.data.codigo));
    }

    match /invitaciones/{codigo} {
      // Consultar un código exacto que ya conoces, para validarlo.
      allow get: if request.auth != null;
      // Solo el admin ve la lista completa y crea o borra códigos.
      allow list, create, delete: if esAdmin();

      // Reclamar: únicamente si está libre, marcándose uno mismo y sin tocar
      // ningún otro campo. Firestore evalúa contra el estado actual, así que
      // dos personas no pueden reclamarlo a la vez.
      allow update: if request.auth != null
                    && resource.data.usadoPor == null
                    && request.resource.data.usadoPor == request.auth.uid
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['usadoPor','usadoEn','correoUsado']);

      // El admin puede liberar o editar un código.
      allow update: if esAdmin();
    }
  }
}
